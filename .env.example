# Copy this file to .env and put your real values in .env (never in this file).
# On Render, add the same names and values in the service's Environment tab.

# --- OpenAI ---
OPENAI_API_KEY=sk-your-key-goes-here

# --- Flask session secret: any long random string. Make one with:
#     python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=replace-with-a-long-random-string

# --- Google sign-in (Google Cloud Console > APIs & Services > Credentials) ---
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# --- AWS storage (leave these out locally to store books in ./local_data instead) ---
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key
# AWS_REGION=us-east-1
# DYNAMODB_TABLE=storybook
# S3_BUCKET=your-bucket-name

# --- Testing: draw placeholder images instead of calling OpenAI (free) ---
# FAKE_IMAGES=1

# Stripe (test mode only: the class sandbox key, sk_test_...)
STRIPE_SECRET_KEY=sk_test_your_key_here
# Optional, only if you set up a webhook endpoint in Stripe
STRIPE_WEBHOOK_SECRET=

# Optional tuning (defaults shown)
# IMAGE_CONCURRENCY=20      # how many pages are drawn at the same time
# VISION_MODEL=gpt-5-mini   # the model that inspects every image
# PLATE_QUALITY=medium      # quality of the one-time scenes (prepare_story.py)
# BOOKS_PER_HOUR=3
# PAGE_QUALITY=low          # medium = Jack's face more consistent, but slower and pricier
